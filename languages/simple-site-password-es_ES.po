msgstr "La protección está activa, pero todavía no hay ninguna contraseña configurada."

msgid "Remember access for"
msgstr "Recordar acceso durante"

msgid "Save settings"
msgstr "Guardar ajustes"

msgid "Set the password and access duration for visitors."
msgstr "Configura la contraseña y la duración del acceso para visitantes."

msgid "Settings saved."
msgstr "Ajustes guardados."

msgid "Show"
msgstr "Mostrar"

msgid "Simple Site Password"
msgstr "Contraseña simple para el sitio"

msgid "Status"
msgstr "Estado"

msgid "Template"
msgstr "Plantilla"

msgid "The form expired. Please try again."
msgstr "El formulario ha caducado. Inténtalo de nuevo."

msgid "Title"
msgstr "Título"

msgid "WPHubb Plugin"
msgstr "Plugin de WPHubb"

msgid "You do not have permission to access this page."
msgstr "No tienes permisos para acceder a esta página."

