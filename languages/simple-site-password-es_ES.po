msgid "Access"
msgstr "Acceso"

msgid "Active"
msgstr "Activo"

msgid "Advanced"
msgstr "Avanzado"

msgid "Allow administrators to bypass protection"
msgstr "Permitir que los administradores omitan la protección"

msgid "Button text"
msgstr "Texto del botón"

msgid "Change"
msgstr "Cambiar"

msgid "Control what happens when the plugin is uninstalled."
msgstr "Controla qué ocurre cuando se desinstala el plugin."

msgid "Customize the password screen shown to visitors."
msgstr "Personaliza la pantalla de contraseña que se muestra a los visitantes."

msgid "Dark"
msgstr "Oscuro"

msgid "Delete settings on uninstall"
msgstr "Borrar ajustes al desinstalar"

msgid "Description"
msgstr "Descripción"

msgid "Design"
msgstr "Diseño"

msgid "Duration in hours. Minimum 1 hour, maximum 720 hours."
msgstr "Duración en horas. Mínimo 1 hora, máximo 720 horas."

msgid "Enable global protection"
msgstr "Activar protección global"

msgid "Enable or disable the global password gate."
msgstr "Activa o desactiva la protección global por contraseña."

msgid "Enter the password to access this site."
msgstr "Introduce la contraseña para acceder a este sitio."

msgid "Gradient"
msgstr "Degradado"

msgid "Hide"
msgstr "Ocultar"

msgid "Inactive"
msgstr "Inactivo"

msgid "Incorrect password. Please try again."
msgstr "Contraseña incorrecta. Inténtalo de nuevo."

msgid "Minimal"
msgstr "Minimalista"

msgid "No password configured"
msgstr "No hay contraseña configurada"

msgid "Password"
msgstr "Contraseña"

msgid "Password configured"
msgstr "Contraseña configurada"

msgid "Passwords are stored hashed, never in plain text. Leave the new password empty to keep the current one."
msgstr "Las contraseñas se guardan con hash, nunca en texto plano. Deja la nueva contraseña vacía para mantener la actual."

